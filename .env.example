# Copy to .env and adjust as needed (used by docker-compose).

# Where the host's Claude credentials directory lives (contains .credentials.json).
# The token is read fresh on every poll, so keeping Claude Code logged in on the
# host keeps the poller authenticated.
CLAUDE_CREDENTIALS_DIR=~/.claude

# Seconds between samples (default 300 = 5 minutes).
POLL_INTERVAL=300

# --- only needed when running app.py directly (not via docker) ---
# PORT=8765
# HOST=0.0.0.0
# DB_PATH=./data/usage.db
# CLAUDE_CREDENTIALS=~/.claude/.credentials.json
# CLAUDE_TOKEN=            # optional: hard-code a token instead of reading the file
